{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myvault-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "QWEN_BASE_URL": "https://token-plan.maas.qwencloudapi.com/compatible-mode/v1",
    "QWEN_MODEL": "qwen3.8-flash",
    "QWEN_ALLOWED_GITHUB_USER": "anthonymankaho",
    "QWEN_MONTHLY_TOKEN_QUOTA": "5000000"
  },
  // Monthly token quota accounting is enforced only when the QWEN_USAGE KV
  // namespace is bound. Create it with:
  //   npx wrangler kv namespace create QWEN_USAGE
  // then paste the production (and preview) IDs below and redeploy.
  // "kv_namespaces": [
  //   { "binding": "QWEN_USAGE", "id": "<production-namespace-id>", "preview_id": "<preview-namespace-id>" }
  // ]
}
