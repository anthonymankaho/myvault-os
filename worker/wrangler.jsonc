{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myvault-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
